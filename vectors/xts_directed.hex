// [0] ENC addr 0, all-zero data, slot 0

// [1] DEC addr 0, all-zero data, slot 0

// [2] ENC max 28-bit addr, slot 0

// [3] DEC max 28-bit addr, slot 0

// [4] ENC all-ones data, slot 0

// [5] DEC all-ones data, slot 0

// [6] ENC addr 1 (little-endian tweak check), slot 0

// [7] DEC addr 1 (little-endian tweak check), slot 0

// [8] ENC same addr + data, slot 0

// [9] DEC same addr + data, slot 0

// [10] ENC same addr + data, slot 1

// [11] DEC same addr + data, slot 1

// [12] ENC same addr + data, slot 2

// [13] DEC same addr + data, slot 2

// [14] ENC same addr + data, slot 3

// [15] DEC same addr + data, slot 3

// [16] ENC near-duplicate keys (K2 = K1 ^ 1 bit)

// [17] DEC near-duplicate keys (K2 = K1 ^ 1 bit)

// [18] ENC alpha carry on T0 -> T1 (0x87 path)

// [19] DEC alpha carry on T0 -> T1 (0x87 path)

// [20] ENC no alpha carry on T0..T2

// [21] DEC no alpha carry on T0..T2

// [22] key-switch seq 0: ENC slot 0

// [23] key-switch seq 1: ENC slot 1

// [24] key-switch seq 2: ENC slot 0

// [25] key-switch seq 3: ENC slot 1

// [26] key-switch seq 4: ENC slot 2

// [27] key-switch seq 5: ENC slot 3

// [28] key-switch seq 6: ENC slot 2

// [29] key-switch seq 7: ENC slot 3

// [30] key-switch seq: DEC slot 3

// [31] key-switch seq: DEC slot 0

// [32] key-switch seq: DEC slot 2

// [33] key-switch seq: DEC slot 1

